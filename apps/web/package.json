{
  "name": "@amax/web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-registry.mjs",
    "seed:demo": "node scripts/gen-registry.mjs && tsx scripts/seed-demo.ts",
    "dev": "node scripts/gen-registry.mjs && next dev",
    "build": "node scripts/gen-registry.mjs && next build",
    "start": "next start",
    "lint": "node scripts/gen-registry.mjs && tsc --noEmit",
    "test": "node scripts/gen-registry.mjs && vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "build:cloudflare": "node scripts/gen-registry.mjs && opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "1.64.1",
    "@types/pngjs": "6",
    "drizzle-orm": "0.45.4",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "wrangler": "4.149.0"
  }
}
