{
  "name": "amax",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@amax/web",
    "lint": "turbo run lint && node scripts/check-graph.mjs",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @amax/db migrate",
    "check:graph": "node scripts/check-graph.mjs",
    "graph": "node scripts/check-graph.mjs --graph"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "turbo": "2.11.9",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
