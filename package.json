{
  "name": "amax",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@amax/web",
    "lint": "turbo run lint && node scripts/check-graph.mjs",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @amax/db migrate",
    "check:graph": "node scripts/check-graph.mjs",
    "graph": "node scripts/check-graph.mjs --graph",
    "build:plugin": "esbuild plugins/amax/scripts/src/read-specclaw.ts --bundle --platform=node --format=esm --target=node20 --outfile=plugins/amax/scripts/read-specclaw.mjs --banner:js='// Generated by pnpm build:plugin from plugins/amax/scripts/src/read-specclaw.ts. Do not edit.'"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turbo": "2.11.9",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "^10.5.0"
    }
  }
}
